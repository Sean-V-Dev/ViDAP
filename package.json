{
  "name": "vidap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "node scripts/verify-node-version.mjs",
    "setup": "node scripts/verify-node-version.mjs && npm.cmd ci && uv --directory python sync --locked",
    "build": "node scripts/verify-node-version.mjs && vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
